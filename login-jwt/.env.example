PORT=8080
NODE_ENV=development
# Genera una clave aleatoria de al menos 32 caracteres para JWT_SECRET.
JWT_SECRET=
JWT_EXPIRES_IN=30s
REFRESH_TOKEN_EXPIRES_MS=604800000
# Sin DATABASE_URL se mantiene MySQL local.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=laboratorio_jwt
# PostgreSQL externo de Render: DB_SSL=true. Conexion interna: false.
DB_SSL=false
# Opcional, separado por comas, solo para frontend en otro origen.
CORS_ORIGIN=
SEED_DEMO=false
DEMO_PASSWORD=
